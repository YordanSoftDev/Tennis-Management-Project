@using TennisManagement.Web.Models.Matches.MatchEnumerations
@model TennisManagement.Web.ViewModels.Matches.MatchFormViewModel

@{
    ViewData["Title"] = "Create Match";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Create New Match</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Players Section -->
                        <h5 class="text-primary border-bottom pb-2 mb-3">Players</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FirstPlayerId" class="form-label fw-semibold"></label>
                                <select asp-for="FirstPlayerId" asp-items="Model.Players" id="firstPlayerSelect" class="form-select">
                                    <option value="">-- Select First Player --</option>
                                </select>
                                <span asp-validation-for="FirstPlayerId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SecondPlayerId" class="form-label fw-semibold"></label>
                                <select asp-for="SecondPlayerId" asp-items="Model.Players" id="secondPlayerSelect" class="form-select">
                                    <option value="">-- Select Second Player --</option>
                                </select>
                                <span asp-validation-for="SecondPlayerId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Match Details Section -->
                        <h5 class="text-primary border-bottom pb-2 mb-3">Match Details</h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="DateTime" class="form-label fw-semibold"></label>
                                <input asp-for="DateTime" class="form-control" type="datetime-local" />
                                <span asp-validation-for="DateTime" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CourtName" class="form-label fw-semibold"></label>
                                <input asp-for="CourtName" class="form-control" placeholder="e.g. Center Court" />
                                <span asp-validation-for="CourtName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="CourtType" class="form-label fw-semibold"></label>
                                <select asp-for="CourtType" asp-items="Html.GetEnumSelectList<CourtType>()" class="form-select">
                                    <option value="">-- Select Court Type --</option>
                                </select>
                                <span asp-validation-for="CourtType" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MatchFormat" class="form-label fw-semibold"></label>
                                <select asp-for="MatchFormat" asp-items="Html.GetEnumSelectList<MatchFormat>()" class="form-select">
                                    <option value="">-- Select Match Format --</option>
                                </select>
                                <span asp-validation-for="MatchFormat" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MatchKind" class="form-label fw-semibold"></label>
                                <select asp-for="MatchKind" asp-items="Html.GetEnumSelectList<MatchKind>()" class="form-select">
                                    <option value="">-- Select Match Kind --</option>
                                </select>
                                <span asp-validation-for="MatchKind" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Organization & Location -->
                        <h5 class="text-primary border-bottom pb-2 mb-3">Venue & Tournament</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="TournamentId" class="form-label fw-semibold"></label>
                                <select asp-for="TournamentId" asp-items="Model.Tournaments" class="form-select">
                                    <option value="">-- Select Tournament --</option>
                                </select>
                                <span asp-validation-for="TournamentId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="VenueId" class="form-label fw-semibold"></label>
                                <select asp-for="VenueId" asp-items="Model.Venues" class="form-select">
                                    <option value="">-- Select Venue --</option>
                                </select>
                                <span asp-validation-for="VenueId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MatchStatus" class="form-label fw-semibold"></label>
                                <select asp-for="MatchStatus" asp-items="Html.GetEnumSelectList<MatchStatus>()" class="form-select">
                                    <option value="">-- Select Status --</option>
                                </select>
                                <span asp-validation-for="MatchStatus" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Optional Score & Duration -->
                        <h5 class="text-primary border-bottom pb-2 mb-3">Results (Optional)</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="ScoreResult" class="form-label fw-semibold"></label>
                                <input asp-for="ScoreResult" class="form-control" placeholder="e.g. 6-4, 6-3" />
                                <span asp-validation-for="ScoreResult" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DurationMinutes" class="form-label fw-semibold"></label>
                                <input asp-for="DurationMinutes" class="form-control" type="number" min="0" placeholder="e.g. 90" />
                                <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="WinnerId" class="form-label fw-semibold"></label>
                                <!-- UPDATED: Added id="winnerSelect" and disabled state by default -->
                                <select asp-for="WinnerId" id="winnerSelect" class="form-select" disabled>
                                    <option value="">-- Select Winner --</option>
                                </select>
                                <span asp-validation-for="WinnerId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to Matches
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i>Save Match
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const firstPlayer = document.getElementById('firstPlayerSelect');
            const secondPlayer = document.getElementById('secondPlayerSelect');
            const winnerSelect = document.getElementById('winnerSelect');

            // Store initial winner selection if returning from server validation
            const initialWinnerValue = "@(Model.WinnerId?.ToString() ?? "")";

            function filterPlayerOptions() {
                const firstVal = firstPlayer.value;
                const secondVal = secondPlayer.value;

                // 1. Disable and hide First Player in Second Player dropdown
                Array.from(secondPlayer.options).forEach(option => {
                    if (option.value && option.value === firstVal) {
                        option.disabled = true;
                        option.hidden = true;
                    } else {
                        option.disabled = false;
                        option.hidden = false;
                    }
                });

                // 2. Disable and hide Second Player in First Player dropdown
                Array.from(firstPlayer.options).forEach(option => {
                    if (option.value && option.value === secondVal) {
                        option.disabled = true;
                        option.hidden = true;
                    } else {
                        option.disabled = false;
                        option.hidden = false;
                    }
                });

                updateWinnerOptions(firstVal, secondVal);
            }

            function updateWinnerOptions(firstVal, secondVal) {
                const currentWinnerVal = winnerSelect.value || initialWinnerValue;

                // Reset Winner dropdown options
                winnerSelect.innerHTML = '<option value="">-- Select Winner --</option>';

                if (firstVal && secondVal) {
                    // Get player display names from selected options
                    const firstText = firstPlayer.options[firstPlayer.selectedIndex].text;
                    const secondText = secondPlayer.options[secondPlayer.selectedIndex].text;

                    // Create option for First Player
                    const opt1 = document.createElement('option');
                    opt1.value = firstVal;
                    opt1.textContent = firstText;
                    winnerSelect.appendChild(opt1);

                    // Create option for Second Player
                    const opt2 = document.createElement('option');
                    opt2.value = secondVal;
                    opt2.textContent = secondText;
                    winnerSelect.appendChild(opt2);

                    // Enable dropdown
                    winnerSelect.disabled = false;

                    // Preserve selected winner if still valid
                    if (currentWinnerVal === firstVal || currentWinnerVal === secondVal) {
                        winnerSelect.value = currentWinnerVal;
                    }
                } else {
                    // Keep disabled if either player is not selected
                    winnerSelect.disabled = true;
                    winnerSelect.value = "";
                }
            }

            firstPlayer.addEventListener('change', filterPlayerOptions);
            secondPlayer.addEventListener('change', filterPlayerOptions);

            // Run on initial page load
            filterPlayerOptions();
        });
    </script>
}