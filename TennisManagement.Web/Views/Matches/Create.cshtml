@using TennisManagement.Web.Models.Matches.MatchEnumerations
@model TennisManagement.Web.ViewModels.Matches.MatchFormViewModel

@{
    ViewData["Title"] = "Create Match";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Create New Match</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Players Section -->
                        <h5 class="text-primary border-bottom pb-2 mb-3">Players</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FirstPlayerId" class="form-label fw-semibold"></label>
                                <input asp-for="FirstPlayerId" class="form-control" type="number" placeholder="Enter First Player ID" />
                                <span asp-validation-for="FirstPlayerId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SecondPlayerId" class="form-label fw-semibold"></label>
                                <input asp-for="SecondPlayerId" class="form-control" type="number" placeholder="Enter Second Player ID" />
                                <span asp-validation-for="SecondPlayerId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Match Details Section -->
                        <h5 class="text-primary border-bottom pb-2 mb-3">Match Details</h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="DateTime" class="form-label fw-semibold"></label>
                                <input asp-for="DateTime" class="form-control" type="datetime-local" />
                                <span asp-validation-for="DateTime" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CourtName" class="form-label fw-semibold"></label>
                                <input asp-for="CourtName" class="form-control" placeholder="e.g. Center Court" />
                                <span asp-validation-for="CourtName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="CourtType" class="form-label fw-semibold"></label>
                                <select asp-for="CourtType" asp-items="Html.GetEnumSelectList<CourtType>()" class="form-select">
                                    <option value="">-- Select Court Type --</option>
                                </select>
                                <span asp-validation-for="CourtType" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MatchFormat" class="form-label fw-semibold"></label>
                                <select asp-for="MatchFormat" asp-items="Html.GetEnumSelectList<MatchFormat>()" class="form-select">
                                    <option value="">-- Select Match Format --</option>
                                </select>
                                <span asp-validation-for="MatchFormat" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MatchKind" class="form-label fw-semibold"></label>
                                <select asp-for="MatchKind" asp-items="Html.GetEnumSelectList<MatchKind>()" class="form-select">
                                    <option value="">-- Select Match Kind --</option>
                                </select>
                                <span asp-validation-for="MatchKind" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Organization & Location -->
                        <h5 class="text-primary border-bottom pb-2 mb-3">Venue & Tournament</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="TournamentId" class="form-label fw-semibold"></label>
                                <input asp-for="TournamentId" class="form-control" type="number" placeholder="Enter Tournament ID" />
                                <span asp-validation-for="TournamentId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="VenueId" class="form-label fw-semibold"></label>
                                <input asp-for="VenueId" class="form-control" type="number" placeholder="Enter Venue ID" />
                                <span asp-validation-for="VenueId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MatchStatus" class="form-label fw-semibold"></label>
                                <select asp-for="MatchStatus" asp-items="Html.GetEnumSelectList<MatchStatus>()" class="form-select">
                                    <option value="">-- Select Status --</option>
                                </select>
                                <span asp-validation-for="MatchStatus" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Optional Score & Duration -->
                        <h5 class="text-primary border-bottom pb-2 mb-3">Results (Optional)</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="ScoreResult" class="form-label fw-semibold"></label>
                                <input asp-for="ScoreResult" class="form-control" placeholder="e.g. 6-4, 6-3" />
                                <span asp-validation-for="ScoreResult" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DurationMinutes" class="form-label fw-semibold"></label>
                                <input asp-for="DurationMinutes" class="form-control" type="number" min="0" placeholder="e.g. 90" />
                                <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="WinnerId" class="form-label fw-semibold"></label>
                                <input asp-for="WinnerId" class="form-control" type="number" placeholder="Optional Winner ID" />
                                <span asp-validation-for="WinnerId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to Matches
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i>Save Match
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}