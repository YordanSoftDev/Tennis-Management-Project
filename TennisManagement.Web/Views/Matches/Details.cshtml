@model TennisManagement.Web.ViewModels.Matches.MatchDetailsViewModel

@{
    ViewData["Title"] = $"Match Details - {Model.FirstPlayerFullName} vs {Model.SecondPlayerFullName}";
}

<div class="container py-3">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0"><i class="bi bi-info-circle"></i> Match Details</h4>
            <span class="badge bg-primary fs-6">@Model.DateTime.ToString("f")</span>
        </div>
        
        <div class="card-body p-4">
            <div class="row align-items-center text-center bg-light rounded p-4 mb-4 border">
                <div class="col-md-5">
                    <h3 class="mb-1">@Model.FirstPlayerFullName</h3>
                    @if (Model.WinnerFullName == Model.FirstPlayerFullName)
                    {
                        <span class="badge bg-success mt-1"><i class="bi bi-trophy-fill"></i> Winner</span>
                    }
                </div>
                <div class="col-md-2 my-3 my-md-0">
                    <span class="badge bg-danger fs-5 px-3 py-2">VS</span>
                </div>
                <div class="col-md-5">
                    <h3 class="mb-1">@Model.SecondPlayerFullName</h3>
                    @if (Model.WinnerFullName == Model.SecondPlayerFullName)
                    {
                        <span class="badge bg-success mt-1"><i class="bi bi-trophy-fill"></i> Winner</span>
                    }
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="p-3 border rounded h-100 bg-white">
                        <h6 class="text-muted uppercase fw-bold mb-2">Tournament Info</h6>
                        <p class="fs-5 mb-0">
                            <i class="bi bi-diagram-3 text-primary me-2"></i>
                            @(Model.TournamentName ?? "Exhibition / Standalone Match")
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 border rounded h-100 bg-white">
                        <h6 class="text-muted uppercase fw-bold mb-2">Venue Location</h6>
                        <p class="fs-5 mb-0">
                            <i class="bi bi-geo-alt text-danger me-2"></i>
                            @(Model.VenueName ?? "Unassigned Court")
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer bg-light p-3 d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                    <i class="bi bi-pencil-square"></i> Edit Match
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete
                </a>
            </div>
        </div>
    </div>
</div>
}
