@model IEnumerable<TennisManagement.Web.ViewModels.Roster.PlayerInfoViewModel>

@{
    ViewData["Title"] = "Player";
}

<div class="container py-4" style="background-color: #ffffff;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #0d233a"><i class="bi bi-people-fill me-2"></i>Players</h2>
        <a asp-action="Create" asp-controller="Players"
           class="btn btn-primary btn-lg px-4 shadow-sm"
           >Add New Player</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4 shadow-sm" role="alert">
            <h4 class="alert-heading">No Players Found!</h4>
            <p class="mb-0">There are currently no players in the database. Click the button above to add your first professional player.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var player in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4" style="background-color: #f8f9fa;">
                        <div class="card-body d-flex flex-column justify-content-between p-4">
                            <!-- Player Name -->
                            <div class="mb-3">
                                <h4 class="fw-bold mb-0" style="color: #0d233a;">
                                    <i class="bi bi-person-badge me-2"></i>@player.FullName
                                </h4>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-flex justify-content-end gap-1 mt-3 pt-3 border-top">
                                <a asp-action="Details" asp-route-id="@player.Id" class="btn btn-outline-dark btn-sm">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@player.Id" class="btn btn-outline-dark btn-sm">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@player.Id" class="btn btn-dark btn-sm text-white">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>