@model IEnumerable<TennisManagement.Web.ViewModels.Roster.PlayerInfoViewModel>

@{
    ViewData["Title"] = "Player Roster";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white fw-bold"><i class="bi bi-people-fill me-2"></i>Player Roster</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-person-plus-fill me-1"></i>Add New Player
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4 shadow-sm" role="alert">
            <h4 class="alert-heading">No Players Found!</h4>
            <p class="mb-0">There are currently no players in the database. Click the button above to add your first professional player.</p>
        </div>
    }
    else
    {
        <div class="card shadow-lg border-0 bg-dark text-white">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead class="table-secondary text-dark">
                            <tr>
                                <th class="py-3 ps-3">Name</th>
                                <th class="py-3">Age</th>
                                <th class="py-3">Country</th>
                                <th class="py-3 text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">
                                        @player.FullName
                                    </td>
                                    <td>@player.Age</td>
                                    <td>@player.Country</td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Details" asp-route-id="@player.Id" class="btn btn-outline-info btn-sm me-1">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@player.Id" class="btn btn-outline-warning btn-sm me-1">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@player.Id" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>