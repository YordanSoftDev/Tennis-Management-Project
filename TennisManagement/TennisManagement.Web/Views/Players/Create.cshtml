@{
}
@model TennisManagement.ViewModels.Roster.PlayerFormViewModel

@{
    ViewData["Title"] = "Add New Player";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 text-white" style="background: rgba(13, 35, 58, 0.88); backdrop-filter: blur(10px);">
                <div class="card-header bg-primary bg-gradient py-2 px-3">
                    <h5 class="mb-0 fs-6"><i class="bi bi-person-plus-fill me-2"></i>Add New Professional Player</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        <!-- Name Section -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-semibold"></label>
                                <input asp-for="FirstName" class="form-control" placeholder="e.g. Carlos" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-semibold"></label>
                                <input asp-for="LastName" class="form-control" placeholder="e.g. Alcaraz" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Demographics -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="Age" class="form-label fw-semibold"></label>
                                <input asp-for="Age" class="form-control" type="number" placeholder="20" />
                                <span asp-validation-for="Age" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="CountryId" class="form-label fw-semibold"></label>
                                <select asp-for="CountryId" asp-items="Model.Countries" class="form-select">
                                    <option value="">-- Select Country --</option>
                                </select>
                                <span asp-validation-for="CountryId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Birthplace" class="form-label fw-semibold"></label>
                                <input asp-for="Birthplace" class="form-control" placeholder="e.g. El Palmar, Spain" />
                                <span asp-validation-for="Birthplace" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Physical Stats -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Height" class="form-label fw-semibold"></label>
                                <input asp-for="Height" class="form-control" placeholder="6'0/(183cm)" />
                                <span asp-validation-for="Height" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Weight" class="form-label fw-semibold"></label>
                                <input asp-for="Weight" class="form-control" placeholder="170 lbs/(77kg)" />
                                <span asp-validation-for="Weight" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Rank -->
                        <div class="row justify-content-center mb-3">
                            <div class="col-md-4">
                                <label asp-for="Rank" class="form-label fw-semibold"></label>
                                <input asp-for="Rank" class="form-control" placeholder="e.g. 1" />
                                <span asp-validation-for="Rank" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-arrow-left me-1"></i>Back to Players
                            </a>
                            <button type="submit" class="btn btn-primary btn-sm px-4">
                                <i class="bi bi-check-circle me-1"></i>Save Player
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}