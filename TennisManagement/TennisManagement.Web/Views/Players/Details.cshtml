@model TennisManagement.ViewModels.Roster.PlayerDetailsViewModel

@{
    ViewData["Title"] = "Player Details";
}

<div class="container py-4">
    <div class="card bg-dark text-white shadow-lg border-0">
        <div class="card-header bg-secondary text-dark d-flex justify-content-between align-items-center">
            <h3 class="mb-0 fw-bold">@Model.FullName</h3>
            <span class="badge bg-dark text-white fs-6">@Model.Country</span>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Age:</dt>
                <dd class="col-sm-9">@Model.Age</dd>

                <dt class="col-sm-3">Birthplace:</dt>
                <dd class="col-sm-9">@Model.Birthplace</dd>

                <dt class="col-sm-3">Height:</dt>
                <dd class="col-sm-9">@Model.Height</dd>

                <dt class="col-sm-3">Weight:</dt>
                <dd class="col-sm-9">@Model.Weight</dd>
            </dl>
        </div>
        <div class="card-footer bg-dark border-secondary d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-light btn-sm">Back to List</a>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm me-1">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">Delete</a>
            </div>
        </div>
    </div>
</div>